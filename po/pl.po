#: dock-right-click-menu@jod.local/lib/dockMenu.js:66
msgid "Configure menu…"
msgstr "Konfiguruj menu…"

#: dock-right-click-menu@jod.local/lib/dockMenu.js:145
msgid "%s (as admin)"
msgstr "%s (jako admin)"

#: dock-right-click-menu@jod.local/lib/dockMenu.js:167
msgid "Folder"
msgstr "Folder"

#: dock-right-click-menu@jod.local/lib/dockMenu.js:178
msgid "Could not run as administrator"
msgstr "Nie udało się uruchomić jako administrator"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:18
msgid "About"
msgstr "O rozszerzeniu"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:24
msgid "Developer"
msgstr "Autor"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:30 dock-right-click-menu@jod.local/preferences/aboutPage.js:55
msgid "Open"
msgstr "Otwórz"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:35
msgid "Version"
msgstr "Wersja"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:39
msgid "License"
msgstr "Licencja"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:43
msgid "Compatible docks"
msgstr "Obsługiwane doki"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:44
msgid "Ubuntu Dock and Dash to Dock"
msgstr "Ubuntu Dock i Dash to Dock"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:49
msgid "Homepage"
msgstr "Strona domowa"

#: dock-right-click-menu@jod.local/preferences/appChooser.js:19
msgid "Choose application"
msgstr "Wybierz aplikację"

#: dock-right-click-menu@jod.local/preferences/appChooser.js:25
msgid "Search applications…"
msgstr "Szukaj aplikacji…"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:18
msgid "General"
msgstr "Ogólne"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:20
msgid "Behaviour"
msgstr "Zachowanie"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:25
msgid "Open a new window"
msgstr "Otwórz nowe okno"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:26
msgid "Focus the app if it is already running"
msgstr "Przełącz na aplikację, jeśli jest już uruchomiona"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:28
msgid "When launching an app"
msgstr "Przy uruchamianiu aplikacji"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:29
msgid "Apps that cannot open a second window are always focused"
msgstr "Aplikacje, które nie mogą otworzyć drugiego okna, są zawsze przełączane"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:39
msgid "Show “Configure menu…” entry"
msgstr "Pokaż pozycję „Konfiguruj menu…”"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:40
msgid "Always shown while the menu is empty"
msgstr "Zawsze widoczna, gdy menu jest puste"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:46
msgid "Administrator mode"
msgstr "Tryb administratora"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:47
msgid "Terminal apps open with sudo, Files opens with administrator rights, other apps run as root through pkexec. Flatpak and Snap apps may not work."
msgstr "Aplikacje terminalowe otwierają się z sudo, Pliki z uprawnieniami administratora, pozostałe aplikacje działają jako root przez pkexec. Aplikacje Flatpak i Snap mogą nie działać."

#: dock-right-click-menu@jod.local/preferences/generalPage.js:52
msgid "Enable administrator mode"
msgstr "Włącz tryb administratora"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:53
msgid "Hold Ctrl while choosing an app to run it as administrator. A password prompt always appears."
msgstr "Przytrzymaj Ctrl, wybierając aplikację, aby uruchomić ją jako administrator. Zawsze pojawi się prośba o hasło."

#: dock-right-click-menu@jod.local/preferences/menuPage.js:27
msgid "Menu"
msgstr "Menu"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:36
msgid "Menu items"
msgstr "Elementy menu"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:37
msgid "Shown when you right-click empty space on the dock. A submenu can hold apps and separators."
msgstr "Wyświetlane po kliknięciu prawym przyciskiem myszy w puste miejsce docka. Podmenu może zawierać aplikacje i separatory."

#: dock-right-click-menu@jod.local/preferences/menuPage.js:92
msgid "Not installed"
msgstr "Nie zainstalowano"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:94
msgid "Hold Ctrl in the menu to run this app as administrator"
msgstr "Przytrzymaj Ctrl w menu, aby uruchomić tę aplikację jako administrator"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:104
msgid "Allow running as administrator"
msgstr "Zezwól na uruchamianie jako administrator"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:124
msgid "— Separator —"
msgstr "— Separator —"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:132 dock-right-click-menu@jod.local/preferences/menuPage.js:148
msgid "Submenu"
msgstr "Podmenu"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:145
msgid "Submenu title"
msgstr "Tytuł podmenu"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:177
msgid "Move up"
msgstr "Przesuń w górę"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:178
msgid "Move down"
msgstr "Przesuń w dół"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:179
msgid "Remove"
msgstr "Usuń"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:207
msgid "Add application"
msgstr "Dodaj aplikację"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:210
msgid "Add separator"
msgstr "Dodaj separator"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:212
msgid "Add submenu"
msgstr "Dodaj podmenu"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:213
msgid "New submenu"
msgstr "Nowe podmenu"
