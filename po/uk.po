#: dock-right-click-menu@jod.local/lib/dockMenu.js:65
msgid "Configure menu…"
msgstr "Налаштувати меню…"

#: dock-right-click-menu@jod.local/lib/dockMenu.js:144
msgid "%s (as admin)"
msgstr "%s (адмін)"

#: dock-right-click-menu@jod.local/lib/dockMenu.js:166
msgid "Folder"
msgstr "Тека"

#: dock-right-click-menu@jod.local/lib/dockMenu.js:177
msgid "Could not run as administrator"
msgstr "Не вдалося запустити від імені адміністратора"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:18
msgid "About"
msgstr "Про розширення"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:24
msgid "Developer"
msgstr "Розробник"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:30 dock-right-click-menu@jod.local/preferences/aboutPage.js:55
msgid "Open"
msgstr "Відкрити"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:35
msgid "Version"
msgstr "Версія"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:39
msgid "License"
msgstr "Ліцензія"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:43
msgid "Compatible docks"
msgstr "Сумісні док-панелі"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:44
msgid "Ubuntu Dock and Dash to Dock"
msgstr "Ubuntu Dock і Dash to Dock"

#: dock-right-click-menu@jod.local/preferences/aboutPage.js:49
msgid "Homepage"
msgstr "Домашня сторінка"

#: dock-right-click-menu@jod.local/preferences/appChooser.js:19
msgid "Choose application"
msgstr "Виберіть застосунок"

#: dock-right-click-menu@jod.local/preferences/appChooser.js:25
msgid "Search applications…"
msgstr "Пошук застосунків…"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:18
msgid "General"
msgstr "Загальні"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:20
msgid "Behaviour"
msgstr "Поведінка"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:25
msgid "Open a new window"
msgstr "Відкривати нове вікно"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:26
msgid "Focus the app if it is already running"
msgstr "Перемикатися на застосунок, якщо він уже запущений"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:28
msgid "When launching an app"
msgstr "Під час запуску застосунку"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:29
msgid "Apps that cannot open a second window are always focused"
msgstr "Застосунки, які не можуть відкрити друге вікно, завжди просто активуються"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:39
msgid "Show “Configure menu…” entry"
msgstr "Показувати пункт «Налаштувати меню…»"

#: dock-right-click-menu@jod.local/preferences/generalPage.js:40
msgid "Always shown while the menu is empty"
msgstr "Завжди показується, поки меню порожнє"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:27
msgid "Menu"
msgstr "Меню"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:35
msgid "Menu items"
msgstr "Елементи меню"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:36
msgid "Shown when you right-click empty space on the dock. A submenu can hold apps and separators. The shield button lets you run an app as administrator by holding Ctrl while choosing it."
msgstr "Показується після клацання правою кнопкою миші на порожньому місці дока. Підменю може містити застосунки та роздільники. Кнопка зі щитом дозволяє запустити застосунок від імені адміністратора, якщо утримувати Ctrl під час вибору."

#: dock-right-click-menu@jod.local/preferences/menuPage.js:84
msgid "Not installed"
msgstr "Не встановлено"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:86
msgid "Hold Ctrl in the menu to run this app as administrator"
msgstr "Утримуйте Ctrl у меню, щоб запустити цей застосунок від імені адміністратора"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:96
msgid "Allow running as administrator"
msgstr "Дозволити запуск від імені адміністратора"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:118
msgid "— Separator —"
msgstr "— Роздільник —"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:125 dock-right-click-menu@jod.local/preferences/menuPage.js:141
msgid "Submenu"
msgstr "Підменю"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:138
msgid "Submenu title"
msgstr "Назва підменю"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:170
msgid "Move up"
msgstr "Перемістити вгору"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:171
msgid "Move down"
msgstr "Перемістити вниз"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:172
msgid "Remove"
msgstr "Вилучити"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:200
msgid "Add application"
msgstr "Додати застосунок"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:203
msgid "Add separator"
msgstr "Додати роздільник"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:205
msgid "Add submenu"
msgstr "Додати підменю"

#: dock-right-click-menu@jod.local/preferences/menuPage.js:206
msgid "New submenu"
msgstr "Нове підменю"
